    {
      "name": "KB1 - Happy path",
      "item": [
        {
          "name": "[KB1] 1. Snapshot kho",
          "request": { "method": "GET", "url": "{{inventoryUrl}}/api/inventory/products" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.response.json().forEach(p => pm.collectionVariables.set('stock_' + p.id, p.stock));"
            ] }
          }]
        },
        {
          "name": "[KB1] 2. Snapshot ví",
          "request": { "method": "GET", "url": "{{paymentUrl}}/api/payments/wallets" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.response.json().forEach(w => pm.collectionVariables.set('bal_' + w.customerId, w.balance));"
            ] }
          }]
        },
        {
          "name": "[KB1] 3. Đặt hàng thành công",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"customerId\": \"C1\",\n  \"productId\": \"P1\",\n  \"quantity\": 2,\n  \"amount\": 2000\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{orderUrl}}/api/orders"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const order = pm.response.json();",
              "pm.collectionVariables.set('kb1OrderId', order.id);",
              "pm.test('Order CONFIRMED', () => pm.expect(order.status).to.eql('CONFIRMED'));",
              "pm.test('Saga COMPLETED', () => pm.expect(order.sagaStatus).to.eql('COMPLETED'));",
              "pm.test('Không có failureReason', () => pm.expect(order.failureReason).to.be.null);"
            ] }
          }]
        },
        {
          "name": "[KB1] 4. Kiểm tra kho",
          "request": { "method": "GET", "url": "{{inventoryUrl}}/api/inventory/products" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const products = Object.fromEntries(pm.response.json().map(p => [p.id, p]));",
              "const before = Number(pm.collectionVariables.get('stock_P1'));",
              "pm.test('P1 giảm đúng 2', () => pm.expect(products.P1.stock).to.eql(before - 2));"
            ] }
          }]
        },
        {
          "name": "[KB1] 5. Kiểm tra ví",
          "request": { "method": "GET", "url": "{{paymentUrl}}/api/payments/wallets" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const wallets = Object.fromEntries(pm.response.json().map(w => [w.customerId, w]));",
              "const before = Number(pm.collectionVariables.get('bal_C1'));",
              "pm.test('C1 giảm đúng 2000', () => pm.expect(wallets.C1.balance).to.eql(before - 2000));"
            ] }
          }]
        },
        {
          "name": "[KB1] 6. Saga logs",
          "request": { "method": "GET", "url": "{{orderUrl}}/api/orders/{{kb1OrderId}}/saga-logs" },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const steps = pm.response.json().map(log => log.step);",
              "pm.test('Đúng thứ tự happy path', () => pm.expect(steps).to.eql(['CREATE_ORDER', 'RESERVE_INVENTORY', 'PROCESS_PAYMENT', 'CONFIRM_ORDER']));"
            ] }
          }]
        }
      ]
    },
